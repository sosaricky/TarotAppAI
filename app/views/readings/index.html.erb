<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tarot</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts - Fuentes místicas -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=MedievalSharp&family=Cormorant+SC:wght@500&display=swap" rel="stylesheet">
<style>
    :root {
      --font-title: 'Cinzel Decorative', cursive;
      --font-text: 'MedievalSharp', cursive;
      --font-content: 'Cormorant SC', serif;
      --color-gold: #FFD700;
      --color-purple: #6a0dad;
      --color-dark: #121017;
      --color-light: #f8f1e5;
    }

    body {
      font-family: var(--font-content);
      background-color: var(--color-dark);
      color: var(--color-light);
      background-image: url('https://www.transparenttextures.com/patterns/black-paper.png');
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, .card-title {
      font-family: var(--font-title);
      letter-spacing: 2px;
      color: var(--color-gold);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .lead {
      font-family: var(--font-text);
      font-size: 1.25rem;
      color: var(--color-light);
    }

    .card-tarot {
      border: none;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(106, 13, 173, 0.3);
      transition: all 0.3s ease;
      margin-bottom: 20px;
      background: rgba(30, 25, 45, 0.8);
      color: var(--color-light);
      border-top: 2px solid var(--color-gold);
    }

    .card-tarot:hover {
      transform: translateY(-10px);
      box-shadow: 0 10px 25px rgba(106, 13, 173, 0.5);
    }

    .card-img-tarot {
      height: 220px;
      object-fit: contain;
      padding: 15px;
      filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.3));
    }

    .btn-purple {
      background: linear-gradient(135deg, var(--color-purple), #8a2be2);
      border: none;
      color: white;
      font-family: var(--font-text);
      font-size: 1.1rem;
      letter-spacing: 1px;
      padding: 10px 25px;
      transition: all 0.3s;
    }

    .btn-purple:hover {
      transform: scale(1.05);
      box-shadow: 0 0 15px rgba(106, 13, 173, 0.7);
    }

    .conclusion-card {
      background: rgba(40, 35, 60, 0.8);
      border-left: 4px solid var(--color-gold);
      color: var(--color-light);
    }

    /* Efecto brillo en títulos */
    .glow {
      animation: glow 2s ease-in-out infinite alternate;
    }

    @keyframes glow {
      from {
        text-shadow: 0 0 5px #fff, 0 0 10px var(--color-gold);
      }
      to {
        text-shadow: 0 0 10px #fff, 0 0 20px var(--color-gold), 0 0 30px var(--color-gold);
      }
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      h1 {
        font-size: 2.2rem;
      }
      .card-img-tarot {
        height: 180px;
      }
    }
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-md navbar-dark bg-dark px-3">
  <a class="navbar-brand" href="/">🔮 Tarot</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAuth">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarAuth">
    <ul class="navbar-nav ms-auto">
      <% if current_user %>
        <li class="nav-item">
          <span class="nav-link">Hola, <%= current_user.email %></span>
        </li>
        <li class="nav-item">
          <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-light ms-2" %>
        </li>
      <% else %>
        <li class="nav-item">
          <%= link_to "Ingresar", new_user_session_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Registrarse", new_user_registration_path, class: "nav-link" %>
        </li>
      <% end %>
    </ul>
  </div>
</nav>
  <div class="container py-4 py-md-5">
    <!-- Header -->
    <header class="text-center mb-4 mb-md-5">
      <h1 class="display-4 glow">✨ Tarot ✨</h1>
      <p class="lead">Descubre lo que las cartas tienen para ti</p>
    </header>
    <!-- Contenedor de la Lectura -->
    <div class="row">
      <!-- Carta n -->
      <% @reading&.cards&.each do |card| %>
      <div class="col-md-4 mb-4">
        <div class="card card-tarot h-100">
          <img src="<%= card&.image_path %>" class="card-img-top card-img-tarot" alt="<%= card&.name %>">
          <div class="card-body">
            <h5 class="card-title text-center"><%= card&.name %></h5>
            <p class="card-text"><%= card&.message %></p>
          </div>
        </div>
      </div>
      <%end%>
    </div>

    <!-- Conclusión y Botón -->
    <div class="text-center mt-4 mt-md-5">
      <% if @reading %>
      <div class="card conclusion-card p-4 mb-4">
        <h4>Conclusión</h4>
        <p><%= @reading ? @reading.conclusion : " " %></p>
      </div>
      <% end  %>
      <%= button_to 'Nueva lectura', readings_path, method: :post, class: 'btn btn-purple btn-lg mt-2' %>
    </div>
  </div>

  <!-- Bootstrap JS (opcional, solo si necesitas funcionalidad) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

