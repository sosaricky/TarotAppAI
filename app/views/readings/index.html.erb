<h1 class="mb-4">Mis lecturas</h1>

<% if @readings.any? %>
  <ul class="list-group">
    <% @readings.each do |reading| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>
          Lectura del <%= reading.created_at.strftime("%d/%m/%Y %H:%M") %>
        </span>

        <%= link_to "Ver", reading_path(reading), class: "btn btn-sm btn-secondary" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Todavía no tenés lecturas.</p>
<% end %>
