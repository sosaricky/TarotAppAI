<h1>Readings</h1>
<h3><%= @reading.name %></h3>
<ul>
    <% @reading.reading_cards.order(:position).each do |reading_card|%>
    <li>
      <%= image_tag(reading_card.card.image_path, alt: reading_card.card.name) %>
      <h4><%= reading_card.card.name %></h4>
      <p><%= reading_card.message %></p>
    </li>
    <% end %>
</ul>
<p><%= @reading.conclusion %></p>
