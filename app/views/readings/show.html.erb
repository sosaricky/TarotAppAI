<% unless user_signed_in? %>
  <%= link_to "← Volver al inicio", root_path, class: "back-home" %>
<% end %>

<h1>Lecturas</h1>
<h3><%= @reading.name %></h3>

<ul class="reading-cards">
  <% @reading.reading_cards.order(:position).each do |reading_card| %>
    <li class="reading-card">
      <%= image_tag(reading_card.card.image_path, alt: reading_card.card.name) %>
      <div class="card-name"><%= reading_card.card.name %></div>
      <p class="card-message"><%= reading_card.message %></p>
    </li>
  <% end %>
</ul>

<div class="reading-conclusion">
  <h4>Conclusión</h4>
  <p><%= @reading.conclusion %></p>
</div>
