<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "TarotApp" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+SC:wght@400;600&display=swap" rel="stylesheet">
    <style>
      :root {

        --color-bg: #121017;
        --color-surface: #1c1824;
        --color-text: #f8f1e5;
        --color-muted: #b5b0a8;
        --color-accent: #ffd700;
        --color-action: #6a0dad;

        --font-title: 'Cinzel Decorative', serif;
        --font-body: 'Cormorant SC', serif;

        --space-xs: 4px;
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 32px;
        --space-xl: 64px;


        --radius-sm: 6px;
        --radius-md: 12px;
      }
      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        min-height: 100%;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.6;
      }


      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-title);
        color: var(--color-accent);
        margin-top: 0;
      }

      h1 {
        font-size: 2.4rem;
      }

      h2 {
        font-size: 1.8rem;
      }

      h3 {
        font-size: 1.4rem;
      }

      p {
        margin-top: 0;
        margin-bottom: var(--space-md);
        color: var(--color-text);
      }

      small,
      .text-muted {
        color: var(--color-muted);
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: var(--space-xl) var(--space-md);
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      button {
        font-family: inherit;
        font-size: 1rem;
      }
      .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: var(--space-md) var(--space-lg);
      }
      .app-header-right {
        display: flex;
        align-items: center;
        gap: var(--space-md);
      }
      .user-greeting {
        color: var(--color-muted);
        font-size: 0.9rem;
      }
      .logout-button {
        background: none;
        border: 1px solid var(--color-muted);
        color: var(--color-muted);

        padding: 6px 12px;
        border-radius: var(--radius-sm);

        cursor: pointer;
      }


      /* Dashboard */
      .dashboard {
        padding-top: var(--space-xl);
      }
      .dashboard-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: var(--space-lg);
      }
      .action {
        background-color: var(--color-surface);
        padding: var(--space-lg);
        border-radius: var(--radius-md);
      }
      .action-title {
        margin-bottom: var(--space-sm);
      }
      .action-description {
        color: var(--color-muted);
        margin-bottom: var(--space-md);
      }
      .action-button {
        display: inline-block;
        padding: 10px 18px;
        background-color: var(--color-action);
        color: white;
        border-radius: var(--radius-sm);
      }
      .action-disabled {
        color: var(--color-muted);
        font-size: 0.9rem;
      }

      /* Home */
.home {
  text-align: center;
}

.home-title {
  font-size: 2.4rem;
  margin-bottom: var(--space-xl);
}

.home-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 360px;
  margin: 0 auto;
}

.home-card {
  display: block;
  padding: var(--space-md);
  background-color: var(--color-surface);
  border: 1px solid var(--color-muted);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-family: var(--font-title);
  font-size: 1.2rem;
}

.home-card:hover {
  border-color: var(--color-accent);
}

    </style>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if user_signed_in?%>
      <header class="app-header">
        <div class="app-header-left">
          <% unless controller_name == "dashboard" && action_name == "index"%>
            <%= link_to "Dashboard", dashboard_path, class: "header-link" %>
          <% end%>
        </div>
        <div class="app-header-right">
          <span class="user-greeting">
            Hola <%= current_user.email %>
          </span>
          <%= button_to "Cerrar sesión",
          destroy_user_session_path,
          method: :delete,
          class: "logout-button" %>
        </div>
      </header>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
