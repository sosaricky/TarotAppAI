<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TarotApp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
      <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts - Fuentes místicas -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=MedievalSharp&family=Cormorant+SC:wght@500&display=swap" rel="stylesheet">
    <style>
    :root {
      --font-title: 'Cinzel Decorative', cursive;
      --font-text: 'MedievalSharp', cursive;
      --font-content: 'Cormorant SC', serif;
      --color-gold: #FFD700;
      --color-purple: #6a0dad;
      --color-dark: #121017;
      --color-light: #f8f1e5;
    }

    body {
      font-family: var(--font-content);
      background-color: var(--color-dark);
      color: var(--color-light);
      background-image: url('https://www.transparenttextures.com/patterns/black-paper.png');
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, .card-title {
      font-family: var(--font-title);
      letter-spacing: 2px;
      color: var(--color-gold);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .lead {
      font-family: var(--font-text);
      font-size: 1.25rem;
      color: var(--color-light);
    }

    .card-tarot {
      border: none;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(106, 13, 173, 0.3);
      transition: all 0.3s ease;
      margin-bottom: 20px;
      background: rgba(30, 25, 45, 0.8);
      color: var(--color-light);
      border-top: 2px solid var(--color-gold);
    }

    .card-tarot:hover {
      transform: translateY(-10px);
      box-shadow: 0 10px 25px rgba(106, 13, 173, 0.5);
    }

    .card-img-tarot {
      height: 220px;
      object-fit: contain;
      padding: 15px;
      filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.3));
    }

    .btn-purple {
      background: linear-gradient(135deg, var(--color-purple), #8a2be2);
      border: none;
      color: white;
      font-family: var(--font-text);
      font-size: 1.1rem;
      letter-spacing: 1px;
      padding: 10px 25px;
      transition: all 0.3s;
    }

    .btn-purple:hover {
      transform: scale(1.05);
      box-shadow: 0 0 15px rgba(106, 13, 173, 0.7);
    }

    .conclusion-card {
      background: rgba(40, 35, 60, 0.8);
      border-left: 4px solid var(--color-gold);
      color: var(--color-light);
    }

    /* Efecto brillo en títulos */
    .glow {
      animation: glow 2s ease-in-out infinite alternate;
    }

    @keyframes glow {
      from {
        text-shadow: 0 0 5px #fff, 0 0 10px var(--color-gold);
      }
      to {
        text-shadow: 0 0 10px #fff, 0 0 20px var(--color-gold), 0 0 30px var(--color-gold);
      }
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      h1 {
        font-size: 2.2rem;
      }
      .card-img-tarot {
        height: 180px;
      }
    
    @media (max-width: 576px) {
    .login-tarot {
      margin: 20px;
      padding: 20px;
    }
  } 
    }
  /* Reset del fondo */
  html, body {
    height: 100%;
    margin: 0;
    background-color: #121017 !important;
    background-image: url('https://www.transparenttextures.com/patterns/black-paper.png') !important;
    font-family: 'Cormorant SC', serif;
  }

  /* Contenedor principal */
  .login-tarot {
    max-width: 450px;
    margin: 50px auto;
    padding: 30px;
    background: rgba(30, 25, 45, 0.9);
    border: 2px solid #FFD700;
    border-radius: 15px;
    box-shadow: 0 0 25px rgba(106, 13, 173, 0.5);
    color: #f8f1e5;
  }

  /* Título */
  .login-tarot h2 {
    font-family: 'Cinzel Decorative', cursive;
    color: #FFD700;
    text-align: center;
    margin-bottom: 25px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* Campos de formulario */
  .login-tarot .field {
    margin-bottom: 20px;
  }

  .login-tarot label {
    display: block;
    margin-bottom: 8px;
    font-family: 'MedievalSharp', cursive;
  }

  .login-tarot input[type="email"],
  .login-tarot input[type="password"] {
    width: 100%;
    padding: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid #6a0dad;
    border-radius: 8px;
    color: #f8f1e5;
    font-family: 'Cormorant SC', serif;
  }

  /* Botón */
  .login-tarot .actions input[type="submit"] {
    background: linear-gradient(135deg, #6a0dad, #8a2be2);
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 8px;
    font-family: 'MedievalSharp', cursive;
    font-size: 1.1rem;
    cursor: pointer;
    width: 100%;
    transition: all 0.3s;
  }

  .login-tarot .actions input[type="submit"]:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(106, 13, 173, 0.4);
  }

  /* Links */
  .login-tarot .links {
    margin-top: 20px;
    text-align: center;
  }

  .login-tarot .links a {
    color: #FFD700;
    text-decoration: none;
    margin: 0 10px;
    font-size: 0.9rem;
  }

  </style>
  </head>

  <body>
    <%= yield %>
  </body>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=MedievalSharp&family=Cormorant+SC:wght@400;600&display=swap" rel="stylesheet">
</html>
