<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body {
        margin: 0;
        padding: 24px;
        background-color: #121017;
        color: #f8f1e5;
        font-family: Georgia, serif;
        font-size: 16px;
        line-height: 1.6;
      }
      .card {
        max-width: 560px;
        margin: 0 auto;
        padding: 32px;
        background-color: #1c1824;
        border-radius: 8px;
      }
      a {
        color: #ffd700;
      }
      .button {
        display: inline-block;
        margin-top: 8px;
        padding: 12px 20px;
        background-color: #6a0dad;
        color: #ffffff;
        text-decoration: none;
        border-radius: 6px;
      }
    </style>
  </head>

  <body>
    <div class="card">
      <%= yield %>
    </div>
  </body>
</html>
