<% if controller_name != 'sessions' %>
  <%= link_to "Ingresar", new_session_path(resource_name), class: "auth-link" %>
<% end %>

<% if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Registrarse", new_registration_path(resource_name), class: "auth-link" %>
<% end %>

<% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "auth-link" %>
<% end %>
