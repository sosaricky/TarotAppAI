<section class="auth">
  <div class="auth-card">
    <h1 class="auth-title">Editar mi cuenta</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-muted">Esperando confirmación de: <%= resource.unconfirmed_email %></p>
      <% end %>

      <div class="auth-field">
        <%= f.label :password %>
        <small class="text-muted">(dejalo en blanco si no querés cambiarla)</small>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <small class="text-muted">(<%= @minimum_password_length %> caracteres mínimo)</small>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="auth-field">
        <%= f.label :current_password %>
        <small class="text-muted">(necesitamos tu contraseña actual para confirmar los cambios)</small>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Actualizar", class: "auth-button" %>
      </div>
    <% end %>

    <div class="auth-actions">
      <%= button_to "Cancelar mi cuenta",
                    registration_path(resource_name),
                    data: { confirm: "¿Estás seguro?", turbo_confirm: "¿Estás seguro?" },
                    method: :delete,
                    class: "auth-button auth-button-danger" %>
    </div>

    <%= link_to "← Volver", :back, class: "back-home" %>
  </div>
</section>
